#Использовать asserts
#Использовать v8storage
#Использовать fs

&Логгер Перем Лог;
&Пластилин Перем МенеджерКонфигуратора;
Перем ВременныеФайлы;

&Опция(Имя = "o object", Описание = "Имя объекта метаданных для отмены захвата (например, Catalog.Номенклатура)")
Перем ИмяОбъекта;

&ПодкомандаПриложения(Имя = "unlock", Описание = "Отменить захват объекта в хранилище конфигурации")
Процедура ПриСозданииОбъекта(&Пластилин НастройкиПриложения)
	
	ВременныеФайлы = НастройкиПриложения.ВременныеФайлы();
	
КонецПроцедуры

&ВыполнениеКоманды
Процедура ОтменитьЗахват() Экспорт
	
	Если ПустаяСтрока(ИмяОбъекта) Тогда
		ВызватьИсключение "Необходимо указать объект (-o) для отмены захвата. Пример: -o Catalog.Номенклатура";
	КонецЕсли;

	Лог.Информация("Попытка отмены захвата объекта: %1", ИмяОбъекта);
	
	МенеджерКонфигуратора.ИнициализироватьСКонтекстом();
	
	// Формирование XML списка для пакетного режима
	Список = Новый СписокОбъектовКонфигурации();
	ВключатьПодчиненные = Ложь;
	Список.ДобавитьОбъектКонфигурации(ИмяОбъекта, ВключатьПодчиненные, "");
	
	ФайлСписка = ВременныеФайлы.НовоеИмяФайла("xml");
	Список.ЗаписатьФайлОбъектов(ФайлСписка);
	
	Попытка
		МенеджерКонфигуратора.ПодключитьсяКХранилищу();
		МенеджерКонфигуратора.ОтменитьЗахватОбъектовВХранилище(ФайлСписка);
		
		// Проверка успешности по логу Конфигуратора
		ПроверитьФайлИнформацииПослеОтменыЗахватаОбъектов();
		
		Лог.Информация("Отмена захвата объекта %1 успешно выполнена.", ИмяОбъекта);
	Исключение
		Лог.Ошибка("Не удалось отменить захват объекта. Возможно, он не был захвачен или нет прав.");
		ОтключитьсяОтХранилища();
		ВызватьИсключение;
	КонецПопытки;
	
	ОтключитьсяОтХранилища();
	
КонецПроцедуры

Процедура ПроверитьФайлИнформацииПослеОтменыЗахватаОбъектов()
	
	ФайлИнформации = МенеджерКонфигуратора.ФайлИнформации();
	Файл = Новый Файл(ФайлИнформации);
	Если НЕ Файл.Существует() Тогда
		Возврат;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	
	// Ищем подстроку без учета регистра, так как 1С пишет "успешно завершена"
	Если Найти(НРег(Текст), "успешно завершен") = 0 Тогда
		Лог.Ошибка("Детали из лога конфигуратора: %1", Текст);
		ВызватьИсключение "Ошибка при отмене захвата объекта по логу конфигуратора.";
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтключитьсяОтХранилища()
	
	Если МенеджерКонфигуратора.ЭтоВременныйКонтекст() Тогда
		МенеджерКонфигуратора.ОтключитьсяОтХранилища();
	КонецЕсли;
	
КонецПроцедуры