#Использовать asserts
#Использовать v8storage
#Использовать fs

&Логгер Перем Лог;
&Пластилин Перем МенеджерКонфигуратора;
Перем ВременныеФайлы;

&Опция(Имя = "o object", Описание = "Имя объекта метаданных для захвата (например, Catalog.Номенклатура)")
Перем ИмяОбъекта;

&ПодкомандаПриложения(Имя = "lock", Описание = "Захватить объект в хранилище конфигурации")
Процедура ПриСозданииОбъекта(&Пластилин НастройкиПриложения)
	
	ВременныеФайлы = НастройкиПриложения.ВременныеФайлы();
	
КонецПроцедуры

&ВыполнениеКоманды
Процедура Захватить() Экспорт
	
	Если ПустаяСтрока(ИмяОбъекта) Тогда
		ВызватьИсключение "Необходимо указать объект (-o) для захвата. Пример: -o Catalog.Номенклатура";
	КонецЕсли;

	Лог.Информация("Попытка захвата объекта: %1", ИмяОбъекта);
	
	МенеджерКонфигуратора.ИнициализироватьСКонтекстом();
	
	// Формирование XML списка для пакетного режима
	Список = Новый СписокОбъектовКонфигурации();
	ВключатьПодчиненные = Ложь;
	Список.ДобавитьОбъектКонфигурации(ИмяОбъекта, ВключатьПодчиненные, "");
	
	ФайлСписка = ВременныеФайлы.НовоеИмяФайла("xml");
	Список.ЗаписатьФайлОбъектов(ФайлСписка);
	
	Попытка
		Если МенеджерКонфигуратора.ЭтоВременныйКонтекст() Тогда
		     МенеджерКонфигуратора.ПодключитьсяКХранилищу();
		КонецЕсли;
		МенеджерКонфигуратора.ЗахватитьОбъектыВХранилище(ФайлСписка);
		
		// Проверка успешности по логу Конфигуратора
		ПроверитьФайлИнформацииПослеЗахватаОбъектов();
		
		Лог.Информация("Объект %1 успешно захвачен в хранилище.", ИмяОбъекта);
	Исключение
		Лог.Ошибка("Не удалось захватить объект. Возможно, он заблокирован другим пользователем или неверно указано имя.");
		ОтключитьсяОтХранилища();
		ВызватьИсключение;
	КонецПопытки;
	
	ОтключитьсяОтХранилища();
	
КонецПроцедуры

Процедура ПроверитьФайлИнформацииПослеЗахватаОбъектов()
	
	ФайлИнформации = МенеджерКонфигуратора.ФайлИнформации();
	Файл = Новый Файл(ФайлИнформации);
	Если НЕ Файл.Существует() Тогда
		Возврат;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	
	Если Найти(Текст, "успешно завершен") = 0 Тогда
		Лог.Ошибка("Детали из лога конфигуратора: %1", Текст);
		ВызватьИсключение "Ошибка при захвате объекта по логу конфигуратора.";
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтключитьсяОтХранилища()
	
	Если МенеджерКонфигуратора.ЭтоВременныйКонтекст() Тогда
		МенеджерКонфигуратора.ОтключитьсяОтХранилища();
	КонецЕсли;
	
КонецПроцедуры